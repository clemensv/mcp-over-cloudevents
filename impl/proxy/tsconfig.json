{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "../proxy/dist",
    "rootDir": "../proxy",
    "declaration": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "../proxy/**/*.ts"
  ],
  "exclude": [
    "../proxy/node_modules",
    "../proxy/dist"
  ]
}
